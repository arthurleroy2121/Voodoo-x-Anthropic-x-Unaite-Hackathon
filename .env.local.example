# Server-only — never use NEXT_PUBLIC_ prefix for API keys
SENSOR_TOWER_API_KEY=
GEMINI_API_KEY=

# Scenario.gg credentials. Some accounts ship a single token; in that case
# leave SCENARIO_API_SECRET empty and lib/scenario.ts falls back to "API_KEY:".
SCENARIO_API_KEY=
SCENARIO_API_SECRET=

# Optional override of the Scenario img2video model used in step 4 (Creative
# Output). Defaults to ByteDance Seedance 2.0 — the model that takes a starting
# frame (`image`) AND a finishing frame (`lastFrameImage`) and renders 15s at
# 720p with no audio. Other available candidates documented at the top of
# lib/scenario.ts (Seedance 2.0 Fast, Seedance 1.5 Pro, Seedance 1 Pro).
# SCENARIO_VIDEO_MODEL_ID=model_bytedance-seedance-2-0

# Public flag — controls dev mock mode (default: false). MUST be absent in production.
NEXT_PUBLIC_USE_DEV_MOCKS=false

# Public flag — exposes a "Test ad URL" panel on the Pattern Analysis tab while step 2
# (Sensor Tower scan) is still being built. Set to "true" to inject a video URL manually.
# MUST be absent / "false" in production.
NEXT_PUBLIC_ALLOW_TEST_AD_URL=false
